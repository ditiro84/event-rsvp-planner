// Event RSVP & Visual Seating Planner - Database Schema
// PostgreSQL + Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// USERS / AUTH
// ---------------------------------------------------------------------------

// PLANNER is every normal subscriber account. ADMIN is internal Gadaova
// staff (support) -- see getOwnedEvent's admin bypass in events.service.ts
// and the /api/admin/* module for what that unlocks.
enum UserRole {
  PLANNER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(PLANNER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events        Event[]
  notifications Notification[]
  articles      Article[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// EVENTS
// ---------------------------------------------------------------------------

enum EventType {
  WEDDING
  BIRTHDAY
  CORPORATE
  CONFERENCE
  GRADUATION
  PARTY
  GALA
  RELIGIOUS
  CHARITY
  OTHER
}

// Categories for the public ticketing side of the product (distinct from
// EventType, which describes a private planner's event). Deliberately kept
// to a small, curated set for the initial launch -- nightlife/small-venue
// events -- rather than trying to cover every Eventbrite category at once.
enum PublicEventCategory {
  NIGHTLIFE
  BOAT_CRUISE
  CONCERT
  FESTIVAL
  COMEDY_SHOW
  PRIVATE_PARTY
  OTHER
}

model Event {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  type        EventType @default(OTHER)
  description String?
  date        DateTime
  startTime   String?
  endTime     String?
  venueName   String?
  venueAddress String?
  capacity    Int?
  imageUrl    String?

  // Public RSVP configuration
  rsvpToken       String    @unique @default(cuid())
  rsvpOpen        Boolean   @default(true)
  rsvpDeadline    DateTime?
  customMessage   String?

  // --- Public ticketing (separate from the private RSVP flow above) ---
  // A private wedding/party event and a public ticketed event (nightclub
  // night, boat cruise) are both just "Event" rows -- isPublic is what
  // switches an event into the ticket-selling flow: it gets a public
  // listing page, ticket types instead of a guest list, and a discovery
  // slug. Deliberately not a separate model/table -- would duplicate date/
  // venue/name and force every future Event feature to be built twice.
  isPublic        Boolean              @default(false)
  publicCategory  PublicEventCategory?
  // Stable, URL-safe identifier for the public event page (/tickets/:slug),
  // generated once from the name at creation and immutable after, same
  // pattern as Article.slug.
  publicSlug      String?              @unique
  publicDescription String?
  minAge          Int?
  coverImageData     Bytes?
  coverImageMimeType String?

  // RSVP form feature toggles
  allowPlusOnes         Boolean @default(true)
  allowPlusOneNames      Boolean @default(true)
  allowMealSelection     Boolean @default(true)
  allowDietary           Boolean @default(true)
  allowAccessibilityInfo Boolean @default(true)
  allowSpecialRequests   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guests          Guest[]
  rsvpQuestions   RSVPQuestion[]
  invitations     EventInvitation[]
  venueLayout     VenueLayout?
  tables          Table[]
  checkIns        CheckIn[]
  invitationCard  EventInvitationCard?
  vendors         Vendor[]
  notifications   Notification[]
  products        Product[]
  orders          Order[]
  payoutAccounts  EventPayoutAccount[]
  paymentEvents   PaymentEvent[]
  ticketTypes     TicketType[]
  emailEvents     EmailEvent[]

  // "Shop Enabled" toggle on the Merchandise dashboard -- guests only see
  // the purchase flow on their RSVP page once this is on, so a planner can
  // set products up before going live.
  merchandiseEnabled Boolean @default(false)

  @@index([userId])
  @@map("events")
}

// ---------------------------------------------------------------------------
// GUESTS / RSVP
// ---------------------------------------------------------------------------

enum RsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
  MAYBE
}

model Guest {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  email     String?
  phone     String?
  groupName String?

  rsvpStatus            RsvpStatus @default(PENDING)
  rsvpRespondedAt        DateTime?
  additionalGuestsCount  Int        @default(0)
  mealPreference         String?
  dietaryRequirements    String?
  accessibilityRequirements String?
  specialNotes           String?
  isVip                  Boolean    @default(false)

  checkedIn   Boolean   @default(false)
  checkedInAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party            GuestParty[]
  rsvpAnswers      RSVPAnswer[]
  invitation       EventInvitation?
  seatAssignment   SeatingAssignment?
  checkIn          CheckIn?
  orders           Order[]
  emailEvents      EmailEvent[]

  @@index([eventId])
  @@index([eventId, rsvpStatus])
  @@index([eventId, email])
  @@map("guests")
}

// Accompanying guests brought by a primary guest ("+1"s, family members, etc.)
// Each party member is a named individual and, like the primary guest, can
// hold their own seat assignment on the venue map (see PartySeatingAssignment).
model GuestParty {
  id      String @id @default(cuid())
  guestId String
  guest   Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  fullName            String
  mealPreference      String?
  dietaryRequirements String?

  createdAt DateTime @default(now())

  seatAssignment PartySeatingAssignment?

  @@index([guestId])
  @@map("guest_party_members")
}

// A host-designed invitation card (PDF or image) attached to invite emails
// and linked in WhatsApp invite messages. One per event, stored directly in
// Postgres (bytea) rather than an external bucket -- these files are small
// (capped in the upload handler) and this avoids needing a separate storage
// service/credentials. Kept in its own table (not columns on Event) so
// normal Event queries never pull these bytes along for the ride.
model EventInvitationCard {
  id       String @id @default(cuid())
  eventId  String @unique
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  data     Bytes
  mimeType String
  fileName String
  size     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("event_invitation_cards")
}

// Optional per-guest personalised invitation link (future: email/SMS sending).
// The MVP primarily uses the event-level rsvpToken; this scaffolds 1:1 invites.
model EventInvitation {
  id        String    @id @default(cuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId   String?   @unique
  guest     Guest?    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  token     String    @default(cuid()) @unique
  channel   String?   // email | sms | whatsapp | manual
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([eventId])
  @@map("event_invitations")
}

enum EmailEventStatus {
  SENT
  FAILED
}

// Every outbound transactional email attempt -- guest invite sends and RSVP
// reminder sends share the same code path (see sendInviteEmail in
// invite.service.ts), so one log covers both. Exists so a planner can see
// *why* a send failed (missing/unverified sending domain, Resend account
// restriction, provider rejection, etc.) without needing server log access
// -- see GET /api/events/:eventId/guests/email-events. recipientEmail/Name
// are snapshotted rather than joined-only so a log entry still reads
// sensibly after the guest is deleted (guestId goes null via SetNull below).
model EmailEvent {
  id      String  @id @default(cuid())
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  guestId String?
  guest   Guest?  @relation(fields: [guestId], references: [id], onDelete: SetNull)

  recipientEmail String
  recipientName  String?
  subject        String

  status       EmailEventStatus
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([guestId])
  @@map("email_events")
}

// Configurable custom RSVP questions (future extension beyond the built-in fields)
model RSVPQuestion {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  label     String
  type      String   @default("text") // text | select | boolean
  options   String?  // JSON-encoded array of options for "select"
  required  Boolean  @default(false)
  order     Int      @default(0)

  answers RSVPAnswer[]

  @@index([eventId])
  @@map("rsvp_questions")
}

model RSVPAnswer {
  id         String       @id @default(cuid())
  guestId    String
  guest      Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  questionId String
  question   RSVPQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  answerText String?
  createdAt  DateTime @default(now())

  @@unique([guestId, questionId])
  @@map("rsvp_answers")
}

// ---------------------------------------------------------------------------
// VENUE / SEATING
// ---------------------------------------------------------------------------

enum LayoutObjectType {
  STAGE
  DANCE_FLOOR
  BAR
  BUFFET
  ENTRANCE
  EXIT
  TOILETS
  DJ_BOOTH
  VIP_AREA
  CUSTOM
}

model VenueLayout {
  id      String @id @default(cuid())
  eventId String @unique
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name          String  @default("Main Layout")
  canvasWidth   Int     @default(1600)
  canvasHeight  Int     @default(1000)
  gridSize      Int     @default(20)
  backgroundColor String @default("#f8fafc")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  objects LayoutObject[]

  @@map("venue_layouts")
}

model LayoutObject {
  id            String           @id @default(cuid())
  venueLayoutId String
  venueLayout   VenueLayout      @relation(fields: [venueLayoutId], references: [id], onDelete: Cascade)

  type     LayoutObjectType @default(CUSTOM)
  label    String?
  x        Float            @default(0)
  y        Float            @default(0)
  width    Float            @default(100)
  height   Float            @default(100)
  rotation Float            @default(0)
  color    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueLayoutId])
  @@map("layout_objects")
}

enum TableShape {
  ROUND
  SQUARE
  RECTANGLE
  OVAL
  BANQUET
  HEAD
  CUSTOM
}

model Table {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name     String
  shape    TableShape @default(ROUND)
  capacity Int        @default(8)
  x        Float      @default(0)
  y        Float      @default(0)
  width    Float      @default(120)
  height   Float      @default(120)
  rotation Float       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seats                   Seat[]
  seatingAssignments      SeatingAssignment[]
  partySeatingAssignments PartySeatingAssignment[]

  @@index([eventId])
  @@map("tables")
}

model Seat {
  id      String @id @default(cuid())
  tableId String
  table   Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  seatNumber Int
  x          Float @default(0)
  y          Float @default(0)

  assignment      SeatingAssignment?
  partyAssignment PartySeatingAssignment?

  @@unique([tableId, seatNumber])
  @@index([tableId])
  @@map("seats")
}

model SeatingAssignment {
  id      String @id @default(cuid())
  guestId String @unique
  guest   Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)
  tableId String
  table   Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  seatId  String? @unique
  seat    Seat?  @relation(fields: [seatId], references: [id], onDelete: SetNull)

  assignedAt DateTime @default(now())

  @@index([tableId])
  @@map("seating_assignments")
}

// A named party member's ("+1"'s) own seat -- mirrors SeatingAssignment but
// points at a GuestParty row instead of a Guest, so each accompanying guest
// gets a real, independent seat on the venue map next to the guest who
// invited them.
model PartySeatingAssignment {
  id            String     @id @default(cuid())
  partyMemberId String     @unique
  partyMember   GuestParty @relation(fields: [partyMemberId], references: [id], onDelete: Cascade)
  tableId       String
  table         Table      @relation(fields: [tableId], references: [id], onDelete: Cascade)
  seatId        String?    @unique
  seat          Seat?      @relation(fields: [seatId], references: [id], onDelete: SetNull)

  assignedAt DateTime @default(now())

  @@index([tableId])
  @@map("party_seating_assignments")
}

// ---------------------------------------------------------------------------
// CHECK-IN
// ---------------------------------------------------------------------------

model CheckIn {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId String @unique
  guest   Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  checkedInAt DateTime @default(now())
  checkedInBy String?

  @@index([eventId])
  @@map("check_ins")
}

// Relation from Table -> SeatingAssignment (reverse, needed for onDelete cascade clarity)

// ---------------------------------------------------------------------------
// VENDORS
// ---------------------------------------------------------------------------

enum VendorCategory {
  CATERING
  VENUE
  PHOTOGRAPHY
  VIDEOGRAPHY
  FLORAL
  MUSIC_ENTERTAINMENT
  DECOR
  RENTALS
  TRANSPORTATION
  BEAUTY
  STATIONERY
  OTHER
}

enum VendorStatus {
  CONTACTED
  QUOTE_RECEIVED
  BOOKED
  CONFIRMED
  CANCELLED
}

model Vendor {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name        String
  category    VendorCategory @default(OTHER)
  status      VendorStatus   @default(CONTACTED)
  contactName String?
  email       String?
  phone       String?
  website     String?
  // Minor currency units (e.g. cents), not a float, to avoid rounding drift.
  costCents   Int?
  currency    Currency @default(USD)
  depositPaid Boolean @default(false)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@map("vendors")
}

// ---------------------------------------------------------------------------
// NOTIFICATIONS
// ---------------------------------------------------------------------------

enum NotificationType {
  RSVP_CONFIRMED
  RSVP_DECLINED
  VENDOR_STATUS_CHANGED
  ORDER_PAID
  SYSTEM
}

model Notification {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String?
  // Frontend route to deep-link into when the notification is clicked,
  // e.g. "/events/:eventId/guests".
  link  String?

  read   Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([eventId])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// MERCHANDISE (event shop)
// ---------------------------------------------------------------------------

// Shared currency label for anything money-related in the app (product
// prices, vendor costs). Chosen per-record by the planner (e.g. a UK-based
// event might price in GBP, a Nigerian one in NGN) -- this is purely a
// display/storage label, not live FX conversion, so totals across records
// with different currencies are reported per-currency rather than blended
// into one misleading number (see costsByCurrency / vendorSpendByCurrency).
// Orders/checkout are still a v2 feature (see ShopSection.tsx), so there's
// no cross-currency cart math to reconcile there yet.
enum Currency {
  USD
  GBP
  NGN
}

// A single sellable item on an event's shop (e.g. favour boxes, t-shirts).
// One optional image, stored the same way as EventInvitationCard (bytes in
// Postgres) rather than an external bucket -- consistent with the rest of
// this app and avoids needing separate storage credentials.
model Product {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name        String
  description String?
  // Minor currency units (cents), not a float, to avoid rounding drift --
  // same convention as Vendor.costCents.
  priceCents  Int
  currency    Currency @default(USD)
  // Null = unlimited stock. Decremented when an order for this product is
  // marked PAID (see markOrderPaid in orders.service.ts).
  stockQuantity Int?
  // Hidden from the guest-facing shop without deleting the product (and its
  // order history) outright.
  active      Boolean @default(true)

  imageData     Bytes?
  imageMimeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@index([eventId])
  @@map("products")
}

// Which processor settles a payout account. Chosen per currency because no
// single processor covers all three: Stripe Connect can't settle NGN into a
// Nigerian bank account, and Nigeria isn't a supported Stripe account
// country at all -- so USD/GBP go through Stripe Connect, NGN goes through
// Paystack, and PayPal is offered as an additional cross-currency option
// wherever the planner has connected one.
enum PayoutProvider {
  STRIPE_CONNECT
  PAYSTACK
  PAYPAL
}

// A planner's payout destination for one currency, via one processor. A
// planner can connect more than one provider for the same currency (e.g.
// both Stripe Connect and PayPal for USD) -- the guest picks at checkout.
// Deliberately does NOT store raw bank account numbers: Stripe Connect's
// bank details are collected entirely on Stripe's own hosted onboarding
// page (see payouts.service.ts), and while Paystack's subaccount API does
// require the account number to pass through our backend once to reach
// Paystack, it is never persisted here -- only the resulting reference
// (subaccountCode) and a masked last-4 for display.
model EventPayoutAccount {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  currency Currency
  provider PayoutProvider

  // --- Stripe Connect (USD/GBP) ---
  stripeAccountId          String?
  stripeOnboardingComplete Boolean @default(false)

  // --- Paystack Subaccount (NGN) ---
  paystackSubaccountCode String?
  paystackBankName       String?
  paystackAccountLast4   String?

  // --- PayPal (cross-currency) ---
  paypalEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@unique([eventId, currency, provider])
  @@index([eventId])
  @@map("event_payout_accounts")
}

// ---------------------------------------------------------------------------
// PUBLIC TICKETING (separate from the merchandise shop above, but reuses
// the same Order/OrderItem/payout machinery -- see OrderKind.TICKET)
// ---------------------------------------------------------------------------

// One purchasable tier on a public (isPublic) event -- e.g. "General
// Admission", "VIP", "Early Bird". A planner defines one or more of these;
// there's no ticketing until at least one exists. quantitySold is
// denormalized (not just derived from paid Tickets) so checkout can check
// remaining capacity with a single read under a transaction lock -- see
// tickets.service.ts reserveTickets.
model TicketType {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name        String
  description String?
  priceCents  Int
  currency    Currency

  // Null = unlimited. quantitySold is only ever incremented inside the same
  // transaction that creates the PENDING order, and decremented if that
  // order is later cancelled/expires unpaid -- see tickets.service.ts.
  quantityTotal Int?
  quantitySold  Int  @default(0)

  salesStartAt DateTime?
  salesEndAt   DateTime?
  minPerOrder  Int @default(1)
  maxPerOrder  Int @default(10)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
  tickets    Ticket[]

  @@index([eventId])
  @@map("ticket_types")
}

enum TicketStatus {
  VALID
  CHECKED_IN
  CANCELLED
}

// One issued, individually-scannable ticket -- created per unit purchased
// once an order is marked PAID (an order for 4 GA tickets creates 4 Ticket
// rows). Deliberately not modeled as a Guest: public ticket buyers usually
// only give one name/email for the whole order, not per-attendee details,
// so this stays a lightweight admission credential rather than forcing the
// private-event Guest/RSVP/seating machinery onto anonymous ticket buyers.
// `code` is the value encoded in the QR (see tickets.service.ts) -- a
// separate random token, not the row id, so ticket codes can't be enumerated.
model Ticket {
  id           String     @id @default(cuid())
  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  code   String       @unique @default(cuid())
  status TicketStatus @default(VALID)

  attendeeName  String?
  attendeeEmail String?

  checkedInAt DateTime?
  checkedInBy String?

  createdAt DateTime @default(now())

  @@index([ticketTypeId])
  @@index([orderId])
  @@map("tickets")
}

// ---------------------------------------------------------------------------
// ADMIN / SUPPORT TOOLING
// ---------------------------------------------------------------------------

// A record of every admin action taken on a subscriber's event -- written
// automatically by the auditAdminEventActions middleware whenever an ADMIN
// user mutates an event they don't own (see events.routes.ts). Deliberately
// has no FK/cascade to Event or User: this history should survive even if
// the event or admin account is later deleted.
model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  adminEmail  String
  eventId     String?
  eventName   String?
  method      String
  summary     String

  createdAt DateTime @default(now())

  @@index([adminUserId])
  @@index([eventId])
  @@map("admin_audit_logs")
}

enum PaymentEventStatus {
  SUCCESS
  FAILED
  EXPIRED
  INFO
}

// A record of every payment attempt reported by Stripe/Paystack/PayPal --
// successes AND declines/failures/expirations, not just the ones that ended
// in a PAID order. Order-level status only tells you the current outcome;
// this is the evidence trail for disputes ("guest says they paid but it
// shows unpaid", chargebacks, etc). rawPayload keeps the provider's own
// response/event body so support can point to the actual record, not just
// our interpretation of it.
model PaymentEvent {
  id      String  @id @default(cuid())
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  provider    PayoutProvider?
  type        String // raw provider event type, e.g. "checkout.session.completed", "charge.failed"
  status      PaymentEventStatus
  amountCents Int?
  currency    Currency?
  message     String? // human-readable summary / decline reason where available
  rawPayload  String // JSON.stringify of the relevant provider object

  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([orderId])
  @@map("payment_events")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

// What an order is actually for -- lets the same Order/OrderItem/checkout
// machinery (currency, provider, platform fee, PENDING->PAID webhook flow)
// serve both the merchandise shop and public ticket sales without a parallel
// set of models. TICKET orders additionally spawn Ticket rows (one per unit
// purchased) once paid -- see markOrderPaid.
enum OrderKind {
  MERCHANDISE
  TICKET
}

// A guest's purchase. Created in PENDING state when a checkout is opened
// with whichever processor the event has connected for this currency, then
// flipped to PAID by that processor's webhook/confirmation once payment
// actually clears -- never marked PAID from a client-trusted call.
model Order {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId String?
  guest   Guest?  @relation(fields: [guestId], references: [id], onDelete: SetNull)

  kind OrderKind @default(MERCHANDISE)

  // Captured directly (not just via guestId) so an order is still
  // identifiable even if the guest record is later removed, and so a guest
  // who hasn't been matched to a Guest row yet can still check out.
  guestName  String
  guestEmail String

  status        OrderStatus @default(PENDING)
  // All items in one order share this currency (carts don't mix currencies
  // -- see ShopSection.tsx) and are settled through this provider, to
  // whichever EventPayoutAccount the planner connected for that pairing.
  currency      Currency
  provider      PayoutProvider?
  payoutAccountId String?
  payoutAccount   EventPayoutAccount? @relation(fields: [payoutAccountId], references: [id], onDelete: SetNull)
  totalCents    Int
  // Gadaova's cut of totalCents -- per PLATFORM_FEE_PERCENT for
  // merchandise orders or TICKET_FEE_PERCENT for ticket orders (see
  // env.ts), at the time of checkout. Kept on the order itself (not
  // recomputed later) so a later change to either percentage doesn't
  // rewrite historical order amounts.
  platformFeeCents Int?
  deliveryMethod String @default("AT_EVENT") // AT_EVENT | SHIPPING (future)

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String?
  paystackReference       String? @unique
  paypalOrderId           String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         OrderItem[]
  paymentEvents PaymentEvent[]
  tickets       Ticket[]

  @@index([eventId])
  @@index([eventId, status])
  @@map("orders")
}

// Line item snapshot -- name/price captured at time of purchase so a later
// product edit (renamed, repriced) doesn't rewrite order history. Points at
// exactly one of product/ticketType depending on Order.kind.
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  ticketTypeId String?
  ticketType   TicketType? @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)

  productName     String
  unitPriceCents  Int
  quantity        Int

  @@index([orderId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// PUBLIC CONTENT (landing page)
// ---------------------------------------------------------------------------

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

// Admin-authored posts shown on the public /articles blog and teased on the
// landing page. Body is plain text with a small set of markdown-style
// conventions (headings, bold, links, ![alt](url) images) rendered by a
// lightweight parser on the frontend -- not a full rich-text/WYSIWYG editor,
// per the agreed scope. Cover image stored as bytes in Postgres, same
// pattern as Product/EventInvitationCard, so no separate storage
// credentials are needed.
model Article {
  id       String @id @default(cuid())
  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  title   String
  // Generated from the title at creation time and immutable after that, so
  // a later title edit never breaks an already-shared /articles/:slug link.
  slug    String @unique
  excerpt String
  body    String

  coverImageData     Bytes?
  coverImageMimeType String?

  status      ArticleStatus @default(DRAFT)
  // Set (or refreshed) whenever an article transitions to PUBLISHED --
  // public listings order by this, not createdAt, so republishing an old
  // draft brings it back to the top rather than leaving it buried.
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@map("articles")
}

// Admin-editable "what we offer" cards on the landing page -- lets a new
// service be added (or an old one hidden) without a code deploy. `icon` is
// a key into a fixed icon set on the frontend (not free-text/SVG upload,
// to keep this from becoming an XSS vector) -- see ICON_OPTIONS in the
// admin Services tab.
model LandingService {
  id          String  @id @default(cuid())
  title       String
  description String
  icon        String
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("landing_services")
}

