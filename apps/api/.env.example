# --- Database ---
# Local dev (docker-compose): postgresql://postgres:postgres@localhost:5432/eventapp?schema=public
# Production (Neon/Railway): use the connection string provided by your DB host, include sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventapp?schema=public"

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="event_rsvp_token"

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:5173"

# --- Public app URL (used to build RSVP links) ---
PUBLIC_APP_URL="http://localhost:5173"

# --- Rate limiting ---
RSVP_RATE_LIMIT_MAX=20
RSVP_RATE_LIMIT_WINDOW_MS=900000

# --- Invite emails (optional) ---
# Enables the "Email invite" button and bulk invite sending. Get an API key
# at https://resend.com and verify a sending domain there first.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="Gadaova <invites@gadaova.com>"

# --- Merchandise checkout: Stripe (USD/GBP payouts, optional) ---
# Powers both regular checkout AND Stripe Connect (planner payout onboarding
# for USD/GBP events) -- Connect just needs to be turned on for this Stripe
# account at https://dashboard.stripe.com/connect/overview, no separate key.
# Get keys at https://dashboard.stripe.com/apikeys (use test keys while
# developing). The webhook secret comes from the endpoint you register at
# https://dashboard.stripe.com/webhooks pointing to POST /api/webhooks/stripe,
# listening for checkout.session.completed AND account.updated (the latter
# tracks when a planner finishes Connect onboarding).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Stripe treats "events on your account" and "events on connected accounts"
# as separate audiences -- if you created a second webhook destination for
# connected-account events (account.updated) instead of adding that audience
# to the one above, it gets its own signing secret. Set it here; both are
# accepted at the same POST /api/webhooks/stripe endpoint. Leave unset if you
# have a single destination covering both audiences.
# STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Merchandise checkout: Paystack (NGN payouts, optional) ---
# Get a secret key at https://dashboard.paystack.com/#/settings/developers.
# Powers both the bank list + account verification on the payout-connection
# form and Subaccount creation (planners never send their bank details to
# us directly at rest -- see payouts.service.ts connectPaystack). Without
# this, planners can't connect an NGN payout account and NGN products stay
# in the "not available to buy yet" state.
# PAYSTACK_SECRET_KEY=

# --- Merchandise checkout: PayPal (cross-currency payout option, optional) ---
# Create an app at https://developer.paypal.com/dashboard/applications.
# Unlike Stripe Connect/Paystack, connecting a planner's PayPal just needs
# their PayPal email (routed via payee.email_address) -- no separate
# approval step. Our 2.5% platform fee on PayPal orders requires Partner/
# BN-code enrollment we don't have yet, so it's attempted and silently
# skipped if PayPal rejects it (see lib/paypalClient.ts) -- the planner
# keeps 100% of PayPal-routed orders until that's set up.
# PAYPAL_MODE=sandbox while testing; set to "live" once ready for real money.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox

# --- Platform fee (optional, defaults to 2.5%) ---
# Gadaova's cut of each merchandise sale, taken via each processor's own
# fee mechanism so the rest settles directly to the planner. Change any time
# from the Railway dashboard -- no code change or app-logic redeploy needed.
# PLATFORM_FEE_PERCENT=2.5

# --- Future integrations (not yet wired) ---
# SMS_PROVIDER_API_KEY=
# STORAGE_BUCKET_URL=
